{
  "name": "ScreenRest",
  "version": "1.0.0",
  "description": "Take mindful screen breaks with Islamic reminders",
  "main": "app/main.js",
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron . --trace-warnings --trace-deprecation --enable-logging --remote-debugging-port=9222",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder build --dir",
    "dist": "electron-builder build",
    "test": "vitest run",
    "test-single": "vitest run $1",
    "coverage": "vitest run --coverage",
    "tdd": "vitest --watch test",
    "lint": "cross-env ./node_modules/.bin/standard",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "prepare": "husky"
  },
  "keywords": [
    "ScreenRest",
    "break",
    "reminder",
    "Islamic",
    "Quran"
  ],
  "author": "hozaifa1",
  "license": "MIT",
  "build": {
    "appId": "com.screenrest.app",
    "productName": "ScreenRest",
    "dmg": {
      "icon": "build/icon.icns",
      "iconSize": 128,
      "contents": [
        {
          "x": 355,
          "y": 125,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 155,
          "y": 125,
          "type": "file"
        }
      ]
    },
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "LSBackgroundOnly": 1,
        "LSUIElement": 1
      }
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "freebsd",
        "pacman",
        "tar.xz",
        "apk"
      ],
      "asarUnpack": "node_modules/macos-notification-state/**"
    },
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    },
    "appx": {
      "identityName": "ScreenRest",
      "publisher": "CN=ScreenRest",
      "publisherDisplayName": "ScreenRest",
      "applicationId": "ScreenRest",
      "displayName": "ScreenRest"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ],
      "asarUnpack": [
        "node_modules/windows-notification-state/**",
        "node_modules/macos-notification-state/**"
      ]
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "nsisWeb": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "standard": {
    "globals": [
      "it",
      "describe",
      "before",
      "after",
      "beforeEach",
      "afterEach",
      "Audio",
      "fetch",
      "Notification",
      "alert",
      "__electronLog"
    ]
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^4.0.16",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "rimraf": "^6.1.2",
    "standard": "^17.1.2",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@particle/dbus-next": "^0.11.4",
    "auto-launch": "^6.0.0-rc1",
    "dompurify": "^3.3.1",
    "electron-log": "^5.4.3",
    "electron-store": "11.0.2",
    "humanize-duration": "^3.33.2",
    "i18next": "^25.7.3",
    "i18next-fs-backend": "^2.6.1",
    "luxon": "^3.7.2",
    "meeussunmoon": "^3.1.0",
    "node-desktop-idle-v2": "^1.1.18",
    "ps-list": "^9.0.0",
    "semver": "^7.7.3"
  }
}
